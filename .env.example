# MEDIATA Orchestrator Environment Variables
# This sample file is copied as the .env if no other is provided
# Secrets present here should be changed in production

# Deployment port
PORT=8088

# Kerberos port
KRB5_CONFIG=classpath:krb5.conf
KERBEROS_PORT=8093

# MongoDB settings
MONGODB_URI=mongodb://mongodb:27017/mediata
MONGODB_HOST_PORT=27017

# JWT secret
JWT_SECRET=9k8w3r2x1p0mN6bV4cZ7aS5dF3gH2jK1lP0qW8eR6tY4uI2o

# Set to false to disable OpenAPI JSON/YAML and Swagger UI.
API_DOCS_ENABLED=true

# Kerberos
KERBEROS_USER=admin
KERBEROS_PASS=changeme
# Compose selects MongoDB. Set to json to retain the legacy file backend.
KERBEROS_IDENTITY_STORE=mongodb
KERBEROS_MONGODB_COLLECTION=kerberos_identities
# Import legacy JSON identities once when MongoDB storage is first enabled.
KERBEROS_MIGRATE_JSON=true

# Docker port mappings
RDF_BUILDER_HOST_PORT=18000
FHIR_API_HOST_PORT=18001
OPENMED_HOST_PORT=8002
ORCHESTRATOR_HOST_PORT=18088
KERBEROS_HOST_PORT=18089
SNOWSTORM_HOST_PORT=19100
SNOWSTORM_ES_HOST_PORT=19200

# Should exttra functionalities be deployed?
PY_LAUNCHER_ENABLED=false
FHIR_LAUNCHER_ENABLED=false
ENABLE_RDF_BUILDER=false
ENABLE_FHIR_API=false
